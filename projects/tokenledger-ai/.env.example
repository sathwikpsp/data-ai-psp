# Defaults are for local synthetic demos only.
TOKENLEDGER_MODE=demo
TOKENLEDGER_BOOTSTRAP_DEMO=true
TOKENLEDGER_DATA_DIR=/data
# Required for production and any HTTP ingestion; choose at least 32 random characters.
TOKENLEDGER_API_KEY=
# Set to a mounted effective-dated JSON price file for real usage.
# TOKENLEDGER_RATE_CARD=/config/rates.json
